      "accent": { "$type": "color", "$value": "#0943a0" },
      "accentLight": { "$type": "color", "$value": "#2563eb" },
      "accentBright": { "$type": "color", "$value": "#60a5fa" },
      "waveHero": { "$type": "color", "$value": "#93a8c7", "$description": "Prata-azulado translúcido para linhas de ondas." },
      "waveFooter": { "$type": "color", "$value": "#7f95b7", "$description": "Azul safira suave para rodapé." },
      "focus": { "$type": "color", "$value": "#4d65ff" },
      "neutral": {
        "0": { "$type": "color", "$value": "#13151a" },
        "50": { "$type": "color", "$value": "#161920" },
        "100": { "$type": "color", "$value": "#1a1d24" },
        "150": { "$type": "color", "$value": "#20242d" },
        "200": { "$type": "color", "$value": "#282d38" },
        "250": { "$type": "color", "$value": "#323846" },
        "300": { "$type": "color", "$value": "#3f4656" },
        "400": { "$type": "color", "$value": "#555e73" },
        "500": { "$type": "color", "$value": "#717c95" },
        "600": { "$type": "color", "$value": "#94a0ba" },
        "700": { "$type": "color", "$value": "#b3bed2" },
        "800": { "$type": "color", "$value": "#d3dbe8" },
        "900": { "$type": "color", "$value": "#eef2f8" },
        "1000": { "$type": "color", "$value": "#ffffff" }
      },
      "blue": {
        "50": { "$type": "color", "$value": "#eef4ff" },
        "100": { "$type": "color", "$value": "#dae6ff" },
        "200": { "$type": "color", "$value": "#b8cfff" },
        "300": { "$type": "color", "$value": "#87adff" },
        "400": { "$type": "color", "$value": "#4a83f5" },
        "500": { "$type": "color", "$value": "#2563eb" },
        "600": { "$type": "color", "$value": "#0a4cc4" },
        "700": { "$type": "color", "$value": "#0943a0" },
        "800": { "$type": "color", "$value": "#0a347c" },
        "900": { "$type": "color", "$value": "#0a2657" },
        "950": { "$type": "color", "$value": "#061634" }
      },
      "whiteAlpha": {
        "3": { "$type": "color", "$value": "rgb(255 255 255 / 0.03)" },
        "6": { "$type": "color", "$value": "rgb(255 255 255 / 0.06)" },
        "10": { "$type": "color", "$value": "rgb(255 255 255 / 0.10)" },
        "16": { "$type": "color", "$value": "rgb(255 255 255 / 0.16)" },
        "24": { "$type": "color", "$value": "rgb(255 255 255 / 0.24)" },
        "50": { "$type": "color", "$value": "rgb(255 255 255 / 0.50)" },
        "62": { "$type": "color", "$value": "rgb(255 255 255 / 0.62)" },
        "80": { "$type": "color", "$value": "rgb(255 255 255 / 0.80)" }
      }
    },
    "semantic": {
      "bg": { "$type": "color", "$value": "{color.primitive.black}" },
      "bgElevated": { "$type": "color", "$value": "{color.primitive.neutral.100}" },
      "fg": { "$type": "color", "$value": "{color.primitive.white}" },
      "fgMuted": { "$type": "color", "$value": "{color.primitive.whiteAlpha.80}" },
      "fgSubtle": { "$type": "color", "$value": "{color.primitive.whiteAlpha.62}" },
      "fgFaint": { "$type": "color", "$value": "{color.primitive.whiteAlpha.50}" },
      "border": { "$type": "color", "$value": "rgba(255, 255, 255, 0.10)", "$description": "Borda contínua ultra-sutil de vidro." },
      "borderSubtle": { "$type": "color", "$value": "rgba(255, 255, 255, 0.08)" },
      "accent": { "$type": "color", "$value": "{color.primitive.accent}" },
      "accentHover": { "$type": "color", "$value": "{color.primitive.accentLight}" },
      "link": { "$type": "color", "$value": "{color.primitive.blue.300}" },
      "selection": { "$type": "color", "$value": "{color.primitive.accent}" },
      "focus": { "$type": "color", "$value": "{color.primitive.focus}" },
      "success": { "$type": "color", "$value": "#2fbf71" },
      "warning": { "$type": "color", "$value": "#f5a524" },
      "danger": { "$type": "color", "$value": "#f04438" },
      "signal": { "$type": "color", "$value": "#60a5fa", "$description": "Estado ao vivo, streaming, agente ativo." }
    }
  },
  "gradient": {
    "hero": { "$type": "color", "$value": "linear-gradient(197deg, rgb(9 67 160 / 0) 13.93%, #0943a0 71.79%)" },
    "sticky": { "$type": "color", "$value": "linear-gradient(-5deg, rgb(9 67 160 / 0) 11.13%, #0943a0 80.28%)" },
    "rowHover": { "$type": "color", "$value": "linear-gradient(90deg, #0943a0 0%, #13151a 100%)" },
    "footer": { "$type": "color", "$value": "linear-gradient(180deg, #0943a0, rgb(9 67 160 / 0) 30%)" }
  },
  "font": {
    "family": {
      "display": { "$type": "fontFamily", "$value": ["Poppins", "Plus Jakarta Sans", "ui-sans-serif", "system-ui", "sans-serif"], "$description": "Títulos e Display geométricos e modernos." },
      "heading": { "$type": "fontFamily", "$value": ["Poppins", "Plus Jakarta Sans", "ui-sans-serif", "system-ui", "sans-serif"] },
      "sans": { "$type": "fontFamily", "$value": ["Plus Jakarta Sans", "Poppins", "Geist", "Aspekta", "ui-sans-serif", "system-ui", "sans-serif"], "$description": "Interface e leitura fluida." },
      "mono": { "$type": "fontFamily", "$value": ["JetBrains Mono", "Geist Mono", "PP Supply Mono", "ui-monospace", "monospace"], "$description": "Rótulos técnicos em caixa alta." }
    },
    "weight": {
      "light": { "$type": "fontWeight", "$value": 300 },
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    },
    "size": {
      "display": { "$type": "dimension", "$value": "clamp(2.5rem, 1.6rem + 4vw, 5.75rem)" },
      "h1": { "$type": "dimension", "$value": "clamp(2.125rem, 1.55rem + 2.55vw, 4rem)" },
      "h2": { "$type": "dimension", "$value": "clamp(1.625rem, 1.3rem + 1.45vw, 2.75rem)" },
      "h3": { "$type": "dimension", "$value": "clamp(1.375rem, 1.2rem + 0.8vw, 1.875rem)" },
      "h4": { "$type": "dimension", "$value": "clamp(1.125rem, 1.04rem + 0.38vw, 1.5rem)" },
      "h5": { "$type": "dimension", "$value": "clamp(1.0625rem, 1.02rem + 0.2vw, 1.25rem)" },
      "bodyLg": { "$type": "dimension", "$value": "clamp(1.0625rem, 1rem + 0.28vw, 1.25rem)" },
      "body": { "$type": "dimension", "$value": "1rem" },
      "bodySm": { "$type": "dimension", "$value": "0.875rem" },
      "labelLg": { "$type": "dimension", "$value": "clamp(1rem, 0.96rem + 0.18vw, 1.125rem)" },
      "label": { "$type": "dimension", "$value": "clamp(0.8125rem, 0.79rem + 0.1vw, 0.875rem)" },
      "labelSm": { "$type": "dimension", "$value": "0.75rem" },
      "micro": { "$type": "dimension", "$value": "0.6875rem" }
    },
    "lineHeight": {
      "tight": { "$type": "number", "$value": 1.04 },
      "heading": { "$type": "number", "$value": 1.14 },
      "snug": { "$type": "number", "$value": 1.3 },
      "body": { "$type": "number", "$value": 1.5 },
      "label": { "$type": "number", "$value": 1.15 }
    },
    "letterSpacing": {
      "display": { "$type": "dimension", "$value": "-0.035em" },
      "h1": { "$type": "dimension", "$value": "-0.03em" },
      "h2": { "$type": "dimension", "$value": "-0.025em" },
      "label": { "$type": "dimension", "$value": "-0.0225rem" },
      "capsWide": { "$type": "dimension", "$value": "0.08em" }
    }
  },
  "space": {
    "$type": "dimension",
    "0": { "$value": "0" },
    "1": { "$value": "0.25rem" },
    "1-5": { "$value": "0.3rem", "$description": "Padding vertical de tag e link da navbar." },
    "2": { "$value": "0.5rem" },
    "3": { "$value": "0.75rem" },
    "4": { "$value": "1rem" },
    "5": { "$value": "1.25rem" },
    "6": { "$value": "1.5rem", "$description": "padding-global e gap do hero." },
    "8": { "$value": "2rem" },
    "10": { "$value": "2.5rem" },
    "12": { "$value": "3rem" },
    "14": { "$value": "3.5rem" },
    "16": { "$value": "4rem", "$description": "Altura útil da navbar." },
    "20": { "$value": "5rem" },
    "24": { "$value": "6rem" },
    "30": { "$value": "7.5rem" },
    "40": { "$value": "10rem" },
    "gutter": { "$value": "clamp(1rem, 0.7rem + 1.2vw, 1.5rem)" },
    "inset": { "$value": "clamp(1.25rem, 0.8rem + 1.8vw, 2.5rem)" },
    "section": { "$value": "clamp(4.5rem, 2.8rem + 7vw, 9.25rem)" },
    "stack": { "$value": "clamp(1.5rem, 1rem + 2vw, 3rem)" }
  },
  "layout": {
    "containerMax": { "$type": "dimension", "$value": "90rem", "$description": ".container-large, 1440px." },
    "containerMd": { "$type": "dimension", "$value": "64rem" },
    "containerSm": { "$type": "dimension", "$value": "48rem" },
    "measure": { "$type": "dimension", "$value": "34rem" },
    "heroCopyMax": { "$type": "dimension", "$value": "55.25rem" },
    "gridColumns": { "$type": "number", "$value": 12 },
    "navHeight": { "$type": "dimension", "$value": "4rem" }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": "0px" },
    "xs": { "$value": "6px", "$description": "Tags compactas e cantos mínimos." },
    "sm": { "$value": "10px", "$description": "Botões, links do menu, inputs, chips e abas." },
    "md": { "$value": "14px", "$description": "Navbar flutuante, cards internos e painéis de detalhe." },
    "lg": { "$value": "18px", "$description": "Frames das telas de SaaS (.frame), cards de projeto, visor modal (.visor__panel) e caixas de arquitetura." },
    "xl": { "$value": "24px", "$description": "Grandes superfícies e modais estendidos." },
    "pill": { "$value": "999px" }
  },
  "border": {
    "width": { "$type": "dimension", "$value": "1px" },
    "solid": { "$type": "dimension", "$value": "1px", "$description": "Borda contínua sutil de vidro (1px solid rgba(255, 255, 255, 0.08) a 0.12)." },
    "glass": { "$type": "dimension", "$value": "1px", "$description": "Borda de vidro translúcido com destaque especular superior inset 0 1px 0 rgba(255, 255, 255, 0.10)." },
    "cornerSize": { "$type": "dimension", "$value": "0.625rem" }
  },
  "shadow": {
    "1": { "$type": "shadow", "$value": "0 1px 2px rgb(0 0 0 / 0.5), 0 0 0 1px rgb(255 255 255 / 0.04)" },
    "2": { "$type": "shadow", "$value": "0 12px 32px -12px rgb(0 0 0 / 0.75), 0 0 0 1px rgb(255 255 255 / 0.05)" },
    "3": { "$type": "shadow", "$value": "0 30px 80px -20px rgb(0 0 0 / 0.85), 0 0 0 1px rgb(255 255 255 / 0.06)" },
    "glow": { "$type": "shadow", "$value": "0 0 0 1px rgb(37 99 235 / 0.45), 0 12px 48px -12px rgb(9 67 160 / 0.7)" },
    "focus": { "$type": "shadow", "$value": "0 0 0 2px #13151a, 0 0 0 4px #4d65ff" }
  },
  "glass": {
    "0": {
      "background": { "$type": "color", "$value": "rgb(19 21 26 / 0.40)" },
      "blur": { "$type": "dimension", "$value": "8px" }
    },
    "1": {
      "background": { "$type": "color", "$value": "rgb(22 25 32 / 0.60)" },
      "blur": { "$type": "dimension", "$value": "12px" }
    },
    "2": {
      "background": { "$type": "color", "$value": "rgb(26 29 36 / 0.75)" },
      "blur": { "$type": "dimension", "$value": "18px" }
    },
    "3": {
      "background": { "$type": "color", "$value": "rgb(32 36 45 / 0.88)" },
      "blur": { "$type": "dimension", "$value": "24px" }
    },
    "saturate": { "$type": "dimension", "$value": "150%" }
  },
  "motion": {
    "ease": {
      "inQuad": { "$type": "cubicBezier", "$value": [0.11, 0, 0.5, 0], "$description": "GSAP power1.in" },
      "outQuad": { "$type": "cubicBezier", "$value": [0.5, 1, 0.89, 1], "$description": "GSAP power1.out" },
      "inOutQuad": { "$type": "cubicBezier", "$value": [0.45, 0, 0.55, 1], "$description": "Reveals IX3." },
      "inCubic": { "$type": "cubicBezier", "$value": [0.32, 0, 0.67, 0], "$description": "Fades IX3." },
      "inOutQuart": { "$type": "cubicBezier", "$value": [0.76, 0, 0.24, 1], "$description": "Preloader." },
      "preloader": { "$type": "cubicBezier", "$value": [0.5, 0, 0, 1] },
      "outExpo": { "$type": "cubicBezier", "$value": [0.16, 1, 0.3, 1] },
      "outQuint": { "$type": "cubicBezier", "$value": [0.22, 1, 0.36, 1] },
      "inOutExpo": { "$type": "cubicBezier", "$value": [0.87, 0, 0.13, 1] }
    },
    "duration": {
      "instant": { "$type": "duration", "$value": "60ms", "$description": "Tick do shuffle binário." },
      "fast": { "$type": "duration", "$value": "150ms" },
      "hover": { "$type": "duration", "$value": "250ms" },
      "base": { "$type": "duration", "$value": "400ms" },
      "medium": { "$type": "duration", "$value": "500ms" },
      "slow": { "$type": "duration", "$value": "700ms" },
      "reveal": { "$type": "duration", "$value": "800ms" },
      "hero": { "$type": "duration", "$value": "1440ms" },
      "preload": { "$type": "duration", "$value": "1500ms" }
    },
    "stagger": {
      "word": { "$type": "duration", "$value": "50ms" },
      "line": { "$type": "duration", "$value": "200ms" },
      "item": { "$type": "duration", "$value": "80ms" }
    }
  },
  "z": {
    "bg": { "$type": "number", "$value": 0 },
    "content": { "$type": "number", "$value": 2 },
    "sticky": { "$type": "number", "$value": 50 },
    "nav": { "$type": "number", "$value": 1000 },
    "dialog": { "$type": "number", "$value": 2000 },
    "toast": { "$type": "number", "$value": 3000 },
    "preloader": { "$type": "number", "$value": 10000 }
  },
  "wave": {
    "$description": "Parâmetros calibrados para movimento sedoso, fluido e orgânico. Linhas prata-gelo sobre fundo carbono.",
    "lineColor": { "$type": "color", "$value": "#93a8c7" },
    "background": { "$type": "color", "$value": "#13151a" },
    "lineWidth": { "$type": "dimension", "$value": "1.35px" },
    "xGap": { "$type": "dimension", "$value": "12px" },
    "yGap": { "$type": "dimension", "$value": "38px" },
    "ampX": { "$type": "dimension", "$value": "16px" },
    "ampY": { "$type": "dimension", "$value": "16px" },
    "speedX": { "$type": "number", "$value": 0.018 },
    "speedY": { "$type": "number", "$value": 0.008 },
    "friction": { "$type": "number", "$value": 0.93 },
    "tension": { "$type": "number", "$value": 0.006 },
    "maxCursorMove": { "$type": "dimension", "$value": "32px" },
    "cursorRadiusMin": { "$type": "dimension", "$value": "240px" },
    "dprCap": { "$type": "number", "$value": 1.75 },
    "maxLines": { "$type": "number", "$value": 130 },
    "maxPoints": { "$type": "number", "$value": 90 }
  },
  "component": {
    "button": {
      "height": { "$type": "dimension", "$value": "2.5rem" },
      "heightSm": { "$type": "dimension", "$value": "2rem" },
      "padLeft": { "$type": "dimension", "$value": "0.75rem" },
      "gap": { "$type": "dimension", "$value": "0.75rem" },
      "fontFamily": { "$type": "fontFamily", "$value": "{font.family.mono}" },
      "background": { "$type": "color", "$value": "{color.semantic.accent}" },
      "text": { "$type": "color", "$value": "{color.primitive.white}" },
      "backgroundHover": { "$type": "color", "$value": "{color.primitive.white}" },
      "textHover": { "$type": "color", "$value": "{color.semantic.accent}" }
    },
    "navLink": {
      "background": { "$type": "color", "$value": "{color.primitive.gray}" },
      "text": { "$type": "color", "$value": "{color.primitive.white}" },
      "backgroundCurrent": { "$type": "color", "$value": "{color.primitive.white}" },
      "textCurrent": { "$type": "color", "$value": "{color.primitive.black}" },
      "padding": { "$type": "dimension", "$value": "0.3rem 0.5rem" }
    },
    "tag": {
      "padding": { "$type": "dimension", "$value": "0.3rem 0.5rem" },
      "background": { "$type": "color", "$value": "{color.primitive.black}" }
    },
    "frame": {
      "barHeight": { "$type": "dimension", "$value": "2rem" },
      "background": { "$type": "color", "$value": "{color.primitive.neutral.100}" },
      "bar": { "$type": "color", "$value": "{color.primitive.neutral.150}" }
    }
  },
  "$extensions": {
    "com.frontier.tailwind.v4": {
      "$description": "Mapa DTCG para Tailwind v4 com fundo carbono e tipografia geométrica.",
      "colors": {
        "bg": "#13151a",
        "fg": "#ffffff",
        "muted": "rgb(255 255 255 / 0.80)",
        "subtle": "rgb(255 255 255 / 0.62)",
        "faint": "rgb(255 255 255 / 0.50)",
        "accent": "#0943a0",
        "accent-hover": "#2563eb",
        "signal": "#60a5fa",
        "wave": "#93a8c7",
        "success": "#2fbf71",
        "warning": "#f5a524",
        "danger": "#f04438"
      },
      "fontFamily": {
        "display": "Poppins, Plus Jakarta Sans, ui-sans-serif, system-ui, sans-serif",
        "sans": "Plus Jakarta Sans, Poppins, Geist, Aspekta, ui-sans-serif, system-ui, sans-serif",
        "mono": "JetBrains Mono, Geist Mono, PP Supply Mono, ui-monospace, monospace"
      },
      "radius": { "none": "0px", "pill": "999px" }
    },
    "com.frontier.portfolio.spec": {
      "fontsPortfolio": ["Poppins", "Plus Jakarta Sans", "JetBrains Mono"],
      "heroWave": {
        "lineColor": "#93a8c7",
        "backgroundColor": "#13151a",
        "waveSpeedX": 0.018,
        "waveSpeedY": 0.008,
        "waveAmpX": 16,
        "waveAmpY": 16,
        "friction": 0.93,
        "tension": 0.006,
        "maxCursorMove": 32,
        "xGap": 12,
        "yGap": 38,
        "lineWidth": 1.35
      },
      "footerWaveLine": "#7f95b7",
      "footerWaveXGap": 12
    }
  }
}
